# Telegram
BOT_TOKEN=123456:replace_me
# Можно указать один ADMIN_ID или несколько через запятую в BOT_ADMINS / ADMIN_IDS
ADMIN_ID=8339239363
BOT_ADMINS=8339239363,123456789
SUPPORT_USERNAME=@your_support

# Railway / web server
PORT=8080
DB_FILE=astrovpn.sqlite3
LOG_LEVEL=INFO

# Payment
PAYMENT_STARS_ENABLED=true
PAYMENT_TRIBUTE_ENABLED=true
STARS_AMOUNT=199
PRICE_RUB=199
SUBSCRIPTION_DAYS=30
TRIBUTE_LINK=https://t.me/tribute/app?startapp=dI5p
TRIBUTE_EVENT=new_donation
# Рекомендуется задать и добавить этот secret в URL webhook: /tribute/webhook?secret=...
TRIBUTE_SECRET=

# VPN / VLESS Reality fallback link
SERVER_ID=1
SERVER_NAME=primary
SERVER_IP=89.127.207.207
VLESS_PORT=443
VLESS_SNI=www.apple.com
VLESS_FINGERPRINT=chrome
VLESS_FLOW=xtls-rprx-vision
VLESS_PUBLIC_KEY=replace_with_reality_public_key
VLESS_SHORT_ID=replace_with_reality_short_id

# 3X-UI panel
XUI_HOST=https://89.127.207.207:2053
XUI_USERNAME=replace_with_3xui_username
XUI_PASSWORD=replace_with_3xui_password
# Optional if your py3xui / 3X-UI setup uses token auth
XUI_TOKEN=
# If empty and XUI_DYNAMIC_INBOUND=true, bot uses the first inbound from 3X-UI
XUI_INBOUND_ID=1
XUI_DYNAMIC_INBOUND=false
MAX_DEVICES=1
MAX_CLIENTS=100
# Optional: if enabled, users receive https://panel/sub/<uuid> instead of manual vless:// link
XUI_SUBSCRIPTION_BASE=

# Optional multi-server pool. If set, it overrides single-server XUI_HOST/SERVER_IP variables.
# XUI_SERVERS_JSON='[{"id":1,"name":"nl-1","host":"https://1.2.3.4:2053","server_ip":"1.2.3.4","max_clients":100,"inbound_id":1,"subscription_base":""}]'
